# Copy to backend/.env for local runs, or set these on Render. Never commit the real .env.

# Local default is a SQLite file. For Neon, paste its connection string:
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./care_companion.db

# Long random string. Changing it signs everyone out.
SECRET_KEY=change-me-to-a-long-random-string

# auto = Gemini if a key is set, otherwise offline. offline = never call a model.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Similarity floor for Gemini retrieval. Tune it on the Grounding test page.
GEMINI_MIN_SCORE=0.62

# nominatim = name new places from OpenStreetMap; off = "Saved place 3"
GEOCODER=nominatim
PLACE_RADIUS_M=150
NEARBY_RADIUS_M=200

# 1 = create demo accounts on an empty database
DEMO_SEED=1
